import "@typespec/http";
import "../main.tsp";

using Http;
using SciEdu;

namespace SciEdu.Chat;

// -----------------------------------------------------------------------------
// Models
// -----------------------------------------------------------------------------

@doc("A chat session belonging to the authenticated user.")
model Chat {
  @doc("Chat ID")
  id: uuid;

  @doc("""
    Display title for the chat. Auto-generated by the backend (typically derived
    from the first user message). May be an empty string for a chat that has not
    yet received any messages. Truncation for display is the client's responsibility.
    """)
  title: string;

  @doc("Timestamp when the chat was created")
  createdAt: utcDateTime;

  @doc("""
    Timestamp when the chat was last updated. Updated whenever a new message is
    appended to the chat. Used as the sort key for the chat history sidebar
    (most recently updated first).
    """)
  updatedAt: utcDateTime;
}

@doc("Paginated list of the authenticated user's chats.")
model PaginatedChatResponse {
  items: Chat[];
  totalPages: int32;
  totalItems: int32;
  currentPage: int32;
  pageSize: int32;
  hasNextPage: boolean;
}

@doc("The role of the message author.")
enum MessageRole {
  User: "user",
  Assistant: "assistant",
}

@doc("The processing status of a message.")
enum MessageStatus {
  Streaming: "streaming",
  Completed: "completed",
  Failed: "failed",
}

@doc("A character participating in an agentic response.")
model Character {
  @doc("Stable character identifier used by message parts and stream events.")
  id: string;

  @doc("Human-readable character name.")
  displayName: string;

  @doc("Character role presented to the user.")
  role: string;
}

@doc("A single invocation of a character while producing an agentic response.")
model AgentRun {
  @doc("Stable run identifier within the message.")
  id: string;

  @doc("ID of the character or agent invoked for this run.")
  agent: string;

  @doc("ID of the agent run that invoked this run, if it was nested.")
  parentRunID?: string;

  @doc("Identifier of the action that summoned this run.")
  summonedBy?: string;
}

@doc("The kind of content represented by a message part.")
enum PartType {
  Text: "text",
  Reasoning: "reasoning",
  ToolCall: "tool_call",
  ToolResult: "tool_result",
}

@doc("A structured part of an agentic assistant message.")
model MessagePart {
  @doc("Part kind.")
  type: PartType;

  @doc("Stable part identifier.")
  id: string;

  @doc("ID of the character or agent that produced this part.")
  agent: string;

  @doc("ID of the agent run that produced this part.")
  agentRunID?: string;

  @doc("Whether the part is internal and should normally be hidden from users.")
  internal?: boolean;

  @doc("Text content for text and reasoning parts.")
  text?: string;

  @doc("Tool-call identifier shared by the corresponding call and result parts.")
  tool_call_id?: string;

  @doc("Tool name for a tool-call part.")
  name?: string;

  @doc("JSON arguments supplied to a tool call.")
  arguments?: unknown;

  @doc("Tool execution status.")
  status?: string;

  @doc("JSON content returned by a tool.")
  content?: unknown;
}

@doc("A single message in a chat session.")
model Message {
  @doc("Message ID")
  id: uuid;

  @doc("""
    Plain-text representation of the message. For an agentic response, this is
    formed by concatenating the `text` of every non-internal `text` part in
    `parts` array order without inserting separators.
    """)
  content: string;

  @doc("Structured agentic content. Omitted for messages without agentic parts.")
  parts?: MessagePart[];

  @doc("Snapshot of the characters used by the agentic response.")
  characters?: Character[];

  @doc("Ordered snapshot of agent invocations, with one entry per run.")
  agentRuns?: AgentRun[];

  @doc("Role of the message author")
  role: MessageRole;

  @doc("ID of the previous message in the chain")
  previousID?: uuid;

  @doc("Processing status of the message")
  status: MessageStatus;

  @doc("Timestamp when the message was created")
  createdAt: utcDateTime;
}

@doc("Announces the characters participating in the response.")
model CastEvent {
  type: "cast";
  characters: Character[];
}

@doc("Signals that an agent has started producing parts.")
model AgentStartEvent {
  type: "agent_start";
  agent: string;
  parent?: string;
  summonedBy?: string;
}

@doc("Starts a structured message part at the specified zero-based index.")
model PartStartEvent {
  type: "part_start";
  index: int32;
  part: MessagePart;
}

@doc("Appends incremental content to the part at the specified index.")
model DeltaEvent {
  type: "delta";
  index: int32;
  delta: string;
}

@doc("Completes a structured message part with its final snapshot.")
model PartEndEvent {
  type: "part_end";
  index: int32;
  part: MessagePart;
}

@doc("Signals that an agent has finished producing parts.")
model AgentEndEvent {
  type: "agent_end";
  agent: string;
}

@doc("Terminates a successfully completed stream.")
model DoneEvent {
  type: "done";
  finishReason?: string;
  status?: MessageStatus;
}

@doc("Terminates a failed stream.")
model ErrorEvent {
  type: "error";
  error: string;
  code: string;
}

@doc("A typed event delivered in the data field of an unnamed SSE frame.")
@discriminated(#{ envelope: "none", discriminatorPropertyName: "type" })
union StreamEvent {
  cast: CastEvent,
  agent_start: AgentStartEvent,
  part_start: PartStartEvent,
  delta: DeltaEvent,
  part_end: PartEndEvent,
  agent_end: AgentEndEvent,
  done: DoneEvent,
  error: ErrorEvent,
}

// -----------------------------------------------------------------------------
// Operations
// -----------------------------------------------------------------------------

@tag("Chat")
@route("/chat")
namespace Chats {
  @doc("""
    List the authenticated user's chats, ordered by `updatedAt` descending
    (most recently updated first). Powers the chat history sidebar.
    """)
  @get
  @useAuth(SciEdu.Auth.SessionCookieAuth)
  op list(
    @query page?: int32 = 1,

    @doc("Number of items per page. Maximum value is 100.")
    @query
    @minValue(1)
    @maxValue(100)
    pageSize?: int32 = 20,
  ): {
    @statusCode statusCode: 200;
    @body body: PaginatedChatResponse;
  } | {
    @statusCode statusCode: 401;
    @body error: SciEdu.Unauthorized;
  };

  @doc("Create a new chat session.")
  @post
  @useAuth(SciEdu.Auth.SessionCookieAuth)
  op create(): {
    @statusCode statusCode: 201;
    @body body: {
      chatID: uuid;
    };
  } | {
    @statusCode statusCode: 401;
    @body error: SciEdu.Unauthorized;
  };

  @doc("Returns chat and all messages in the chat.")
  @route("/{chatId}")
  @get
  @useAuth(SciEdu.Auth.SessionCookieAuth)
  op get(@path chatId: uuid): {
    @statusCode statusCode: 200;
    @body body: {
      ...Chat;
      messages: Message[];
    };
  } | {
    @statusCode statusCode: 401;
    @body error: SciEdu.Unauthorized;
  } | {
    @statusCode statusCode: 404;
    @body error: SciEdu.ProblemDetail;
  };

  @doc("""
      Delete a chat session and all of its messages. Only the chat's owner may
      delete it; requests for chats owned by another user return 404 (the chat
      is not visible to the caller).
    """)
  @route("/{chatId}")
  @delete
  @useAuth(SciEdu.Auth.SessionCookieAuth)
  op delete(@path chatId: uuid): {
    @statusCode statusCode: 204;
  } | {
    @statusCode statusCode: 401;
    @body error: SciEdu.Unauthorized;
  } | {
    @statusCode statusCode: 404;
    @body error: SciEdu.ProblemDetail;
  };

  @doc("Send a message to a chat session. Returns the sent message and the ID of the pending reply message.")
  @route("/{chatId}")
  @post
  @useAuth(SciEdu.Auth.SessionCookieAuth)
  op createMessage(
    @path chatId: uuid,
    @body body: {
      content: string;
      previousID?: uuid;
      preset?: string;
    },
  ):
    | {
        @statusCode statusCode: 201;
        @body body: {
          @doc("The user's message that was just sent. Its `id` is the ID of the user's message.")
          message: Message;

          @doc("""
            The ID of the assistant's reply message, which is pre-created in a `streaming` state.
            The SSE stream endpoint (`GET /chat/stream/{messageId}`) expects the assistant's message ID — that is this field.
            The `message.id` in this response is the user's message ID, which cannot be used to open a stream.
            """)
          replyMessageID: uuid;
        };
      }
    | {
        @statusCode statusCode: 400;
        @body error: SciEdu.ProblemDetail;
      }
    | {
        @statusCode statusCode: 401;
        @body error: SciEdu.Unauthorized;
      }
    | {
        @statusCode statusCode: 404;
        @body error: SciEdu.ProblemDetail;
      };

  @route("/stream/{messageId}")
  namespace Stream {
    @doc("""
      Stream the assistant reply for a given message using unnamed Server-Sent
      Event frames (`data: <json>`). The `done` and `error` event types terminate
      the stream. Returns 404 if the messageId does not exist, or 400 if the
      message has no reply pending yet.
      """)
    @get
    @useAuth(SciEdu.Auth.SessionCookieAuth)
    op get(@path messageId: uuid):
      | {
          @statusCode statusCode: 200;
          @header("Content-Type") contentType: "text/event-stream";
          @header("Cache-Control") cacheControl: "no-cache";
          @header("Connection") connection: "keep-alive";
          @body body: StreamEvent;
        }
      | {
          @statusCode statusCode: 400;
          @body error: SciEdu.ProblemDetail;
        }
      | {
          @statusCode statusCode: 401;
          @body error: SciEdu.Unauthorized;
        }
      | {
          @statusCode statusCode: 404;
          @body error: SciEdu.ProblemDetail;
        };
  }
}
