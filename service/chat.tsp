import "@typespec/http";
import "../main.tsp";

using Http;
using SciEdu;

namespace SciEdu.Chat;

// -----------------------------------------------------------------------------
// Models
// -----------------------------------------------------------------------------

@doc("A chat session belonging to the authenticated user.")
model Chat {
  @doc("Chat ID")
  id: uuid;

  @doc("""
    Display title for the chat. Auto-generated by the backend (typically derived
    from the first user message). May be an empty string for a chat that has not
    yet received any messages. Truncation for display is the client's responsibility.
    """)
  title: string;

  @doc("Timestamp when the chat was created")
  createdAt: utcDateTime;

  @doc("""
    Timestamp when the chat was last updated. Updated whenever a new message is
    appended to the chat. Used as the sort key for the chat history sidebar
    (most recently updated first).
    """)
  updatedAt: utcDateTime;
}

@doc("Paginated list of the authenticated user's chats.")
model PaginatedChatResponse {
  items: Chat[];
  totalPages: int32;
  totalItems: int32;
  currentPage: int32;
  pageSize: int32;
  hasNextPage: boolean;
}

@doc("The role of the message author.")
enum MessageRole {
  User: "user",
  Assistant: "assistant",
}

@doc("The processing status of a message.")
enum MessageStatus {
  Streaming: "streaming",
  Completed: "completed",
  Failed: "failed",
}

@doc("A single message in a chat session.")
model Message {
  @doc("Message ID")
  id: uuid;

  @doc("Message content")
  content: string;

  @doc("Role of the message author")
  role: MessageRole;

  @doc("ID of the previous message in the chain")
  previousID?: uuid;

  @doc("Processing status of the message")
  status: MessageStatus;

  @doc("Timestamp when the message was created")
  createdAt: utcDateTime;
}

@doc("A content delta chunk from the SSE stream.")
model StreamDelta {
  @doc("The streamed content fragment")
  content: string;
}

// -----------------------------------------------------------------------------
// Operations
// -----------------------------------------------------------------------------

@tag("Chat")
@route("/chat")
namespace Chats {
  @doc("""
    List the authenticated user's chats, ordered by `updatedAt` descending
    (most recently updated first). Powers the chat history sidebar.
    """)
  @get
  op list(
    @query page?: int32 = 1,

    @doc("Number of items per page. Maximum value is 100.")
    @query
    @minValue(1)
    @maxValue(100)
    pageSize?: int32 = 20,
  ): {
    @statusCode statusCode: 200;
    @body body: PaginatedChatResponse;
  } | {
    @statusCode statusCode: 401;
    @body error: SciEdu.Unauthorized;
  };

  @doc("Create a new chat session.")
  @post
  op create(): {
    @statusCode statusCode: 201;
    @body body: {
      chatID: uuid;
    };
  } | {
    @statusCode statusCode: 401;
    @body error: SciEdu.Unauthorized;
  };

  @doc("List all messages in a chat session.")
  @route("/{chatId}")
  @get
  op get(@path chatId: uuid): {
    @statusCode statusCode: 200;
    @body body: {
      messages: Message[];
    };
  } | {
    @statusCode statusCode: 401;
    @body error: SciEdu.Unauthorized;
  } | {
    @statusCode statusCode: 404;
    @body error: SciEdu.ProblemDetail;
  };

  @doc("""
    Delete a chat session and all of its messages. Only the chat's owner may
    delete it; requests for chats owned by another user return 404 (the chat
    is not visible to the caller).
    """)
  @route("/{chatId}")
  @delete
  op delete(@path chatId: uuid): {
    @statusCode statusCode: 204;
  } | {
    @statusCode statusCode: 401;
    @body error: SciEdu.Unauthorized;
  } | {
    @statusCode statusCode: 404;
    @body error: SciEdu.ProblemDetail;
  };

  @doc("Send a message to a chat session. Returns the sent message and the ID of the pending reply message.")
  @route("/{chatId}")
  @post
  op createMessage(
    @path chatId: uuid,
    @body body: {
      content: string;
      previousID?: uuid;
    },
  ):
    | {
        @statusCode statusCode: 201;
        @body body: {
          @doc("The user's message that was just sent. Its `id` is the ID of the user's message.")
          message: Message;

          @doc("""
            The ID of the assistant's reply message, which is pre-created in a `streaming` state.
            The SSE stream endpoint (`GET /chat/stream/{messageId}`) expects the assistant's message ID — that is this field.
            The `message.id` in this response is the user's message ID, which cannot be used to open a stream.
            """)
          replyMessageID: uuid;
        };
      }
    | {
        @statusCode statusCode: 400;
        @body error: SciEdu.ProblemDetail;
      }
    | {
        @statusCode statusCode: 401;
        @body error: SciEdu.Unauthorized;
      }
    | {
        @statusCode statusCode: 404;
        @body error: SciEdu.ProblemDetail;
      };

  @route("/stream/{messageId}")
  namespace Stream {
    @doc("Stream the assistant reply for a given message using Server-Sent Events. Returns 404 if the messageId does not exist, 400 if the message has no reply pending yet.")
    @get
    op get(@path messageId: uuid):
      | {
          @statusCode statusCode: 200;
          @header("Content-Type") contentType: "text/event-stream";
          @header("Cache-Control") cacheControl: "no-cache";
          @header("Connection") connection: "keep-alive";
          @body body: StreamDelta;
        }
      | {
          @statusCode statusCode: 400;
          @body error: SciEdu.ProblemDetail;
        }
      | {
          @statusCode statusCode: 401;
          @body error: SciEdu.Unauthorized;
        }
      | {
          @statusCode statusCode: 404;
          @body error: SciEdu.ProblemDetail;
        };
  }
}
