import "@typespec/http";
import "../main.tsp";

using Http;
using SciEdu;

namespace SciEdu.Auth;

// -----------------------------------------------------------------------------
// Models
// -----------------------------------------------------------------------------

/**
 * Supported OAuth providers for user login.
 */
enum OAuthLoginProvider {
  google: "GOOGLE",
}

/**
 * Session metadata exposed to the frontend.
 *
 * Token values are intentionally omitted. Access and refresh tokens are issued
 * only through HttpOnly cookies.
 */
model AuthSession {
  @doc("The access token expiration timestamp.")
  accessTokenExpiresAt: utcDateTime;

  @doc("The refresh token expiration timestamp.")
  refreshTokenExpiresAt: utcDateTime;
}

/**
 * CSRF bootstrap response for cookie-authenticated unsafe requests.
 */
model CsrfTokenResponse {
  @doc("The CSRF token that must be sent in the X-CSRF-Token header.")
  csrfToken: string;
}

/**
 * Login payload for development purposes.
 */
model DevLoginRequest {
  @doc("The email to simulate login (must already exist in the Users table)")
  @format("email")
  email: string;
}

// -----------------------------------------------------------------------------
// Operations
// -----------------------------------------------------------------------------

@tag("Auth")
@route("/auth")
interface Auth {
  /**
   * Start an OAuth login flow.
   *
   * The backend validates the callback and redirect URLs, stores OAuth state,
   * and redirects the browser to the provider authorization URL.
   */
  @doc("Login with OAuth provider")
  @get
  @route("/login/oauth/{oauthProvider}")
  loginOAuth(
    @doc("The OAuth provider to use for login.")
    @path
    oauthProvider: OAuthLoginProvider,

    @doc("The frontend callback URL that started the login flow.")
    @query
    c: string,

    @doc("The frontend URL to redirect to after login completes.")
    @query
    r?: string,

    @doc("Custom backend callback base URL. Only available in development mode.")
    @query
    base?: string,
  ): {
    @statusCode statusCode: 302;
    @header("Location") location: string;
  } | NotFound | ProblemDetail;

  /**
   * Complete an OAuth login flow.
   *
   * On success, this endpoint sets access_token and refresh_token HttpOnly
   * cookies and redirects the browser to the previously validated redirect URL.
   */
  @doc("OAuth provider callback")
  @get
  @route("/callback")
  callback(
    @doc("Authorization code returned by the OAuth provider.")
    @query
    code?: string,

    @doc("Opaque state value generated by the backend when login started.")
    @query
    state?: string,

    @doc("OAuth provider error code when authorization failed.")
    @query
    error?: string,
  ): {
    @statusCode statusCode: 302;
    @header("Location") location: string;
    @header("Set-Cookie") setCookie: string[];
  } | Unauthorized | ProblemDetail;

  @doc("Get current auth session metadata")
  @get
  @route("/session")
  session(): {
    @statusCode statusCode: 200;
    @body session: AuthSession;
  } | Unauthorized | ProblemDetail;

  /**
   * Rotate the refresh token and issue a fresh access token.
   *
   * The refresh token is read from the refresh_token HttpOnly cookie. Token
   * strings are never accepted in the URL or response body.
   */
  @doc("Refresh the access token")
  @post
  @route("/refresh")
  refresh():
    | {
        @statusCode statusCode: 200;
        @header("Set-Cookie") setCookie: string[];
        @body session: AuthSession;
      }
    | Unauthorized
    | Forbidden
    | ProblemDetail;

  @doc("Logout the current session")
  @post
  @route("/logout")
  logout():
    | {
        @statusCode statusCode: 204;
        @header("Set-Cookie") setCookie: string[];
      }
    | Unauthorized
    | Forbidden
    | ProblemDetail;

  @doc("Get a CSRF token for cookie-authenticated unsafe requests")
  @get
  @route("/csrf")
  csrf(): {
    @statusCode statusCode: 200;
    @body response: CsrfTokenResponse;
  } | ProblemDetail;

  /**
   * Development backdoor.
   *
   * Bypasses OAuth and issues cookies directly for an existing user email.
   */
  @doc("Internal login for development")
  @post
  @route("/login/internal")
  internalLogin(@body body: DevLoginRequest):
    | {
        @statusCode statusCode: 200;
        @header("Set-Cookie") setCookie: string[];
        @body session: AuthSession;
      }
    | NotFound
    | Forbidden
    | ProblemDetail;
}
